{"stats":{"took":72,"total":282,"estimate":false,"maxScore":155.12787},"results":[{"_meta":{"score":155.12787},"copyright":{"thirdPartyPermissionsProduced":false,"disclosedToPublic":false,"containsIndication":false,"publisherPermissionOrRightsToDistribute":false,"belongsToUsGov":false,"determinationType":"GOV_PUBLIC_USE_PERMITTED","thirdPartyContentCondition":"NOT_SET","belongsToContractor":false,"disclosedInvention":false,"submissionId":20040053527,"containsThirdPartyMaterial":false,"belongsToPublisher":false,"id":"063401c8e04f411680eb8749686fb2a2","belongsToAuthors":false},"subjectCategories":["Space Transportation And Safety"],"exportControl":{"isExportControl":"NO","submissionId":20040053527,"ear":"NO","id":"82f98531c7394d7fa101ceecb3ee2888","itar":"NO"},"distributionDate":"2019-08-16T12:51:43.2100000+00:00","title":"Oxygen and Fuel Jet Diffusion Flame Studies in Microgravity Motivated by Spacecraft Oxygen Storage Fire Safety","stiType":"CONFERENCE_PAPER","distribution":"PUBLIC","submittedDate":"2013-08-21T17:34:00.0000000+00:00","authorAffiliations":[{"sequence":0,"submissionId":20040053527,"meta":{"author":{"name":"Sunderland, P. B."},"organization":{"name":"National Center for Microgravity Research on Fluids and Combustion","location":"Cleveland, OH, United States"}},"id":"506cec8d625242cd84fc5cfc7b599bf3"},{"sequence":1,"submissionId":20040053527,"meta":{"author":{"name":"Yuan, Z.-G."},"organization":{"name":"National Center for Microgravity Research on Fluids and Combustion","location":"Cleveland, OH, United States"}},"id":"56b4e3ea2ec345c59c3f1879dc1447f3"},{"sequence":2,"submissionId":20040053527,"meta":{"author":{"name":"Krishnan, S. S."},"organization":{"name":"Indiana Univ.-Purdue Univ.","location":"Indianapolis, IN, United States"}},"id":"89d13bc21c5b4e9fa9d5193b3275012b"},{"sequence":3,"submissionId":20040053527,"meta":{"author":{"name":"Abshire, J. M."},"organization":{"name":"Indiana Univ.-Purdue Univ.","location":"Indianapolis, IN, United States"}},"id":"d604cdcb2c7a46eba8f4f1312f35c6fd"},{"sequence":4,"submissionId":20040053527,"meta":{"author":{"name":"Gore, J. P."},"organization":{"name":"Purdue Univ.","location":"West Lafayette, IN, United States"}},"id":"f1e38d3878c54ec3ac42554aae257a87"}],"stiTypeDetails":"Conference Paper","technicalReviewType":"TECHNICAL_REVIEW_TYPE_NONE","modified":"2025-08-31T18:39:21.7150190+00:00","id":20040053527,"legacyMeta":{"__type":"LegacyMetaIndex, StrivesApi.ServiceModel","accessionNumber":""},"created":"2013-08-21T17:34:00.0000000+00:00","center":{"code":"GRC","name":"Glenn Research Center","id":"19eeb25fa404421d9eaa5f876e853e3c"},"onlyAbstract":false,"sensitiveInformation":2,"abstract":"Owing to the absence of past work involving flames similar to the Mir fire namely oxygen-enhanced, inverse gas-jet diffusion flames in microgravity the objectives of this work are as follows: 1. Observe the effects of enhanced oxygen conditions on laminar jet diffusion flames with ethane fuel. 2. Consider both earth gravity and microgravity. 3. Examine both normal and inverse flames. 4. Compare the measured flame lengths and widths with calibrated predictions of several flame shape models. This study expands on the work of Hwang and Gore which emphasized radiative emissions from oxygen-enhanced inverse flames in earth gravity, and Sunderland et al. which emphasized the shapes of normal and inverse oxygen-enhanced gas-jet diffusion flames in microgravity.","isLessonsLearned":false,"disseminated":"DOCUMENT_AND_METADATA","publications":[{"submissionId":20040053527,"id":"b03cb7532036418e9e0db8b3e133cf9f","publicationName":"Seventh International Workshop on Microgravity Combustion and Chemically Reacting Systems","publicationDate":"2003-08-01T00:00:00.0000000+00:00"}],"status":"CURATED","related":[{"disseminated":"DOCUMENT_AND_METADATA","id":20040053504,"type":"ANALYTIC_PRIMARY","title":"Seventh International Workshop on Microgravity Combustion and Chemically Reacting Systems","stiType":"CONFERENCE_PROCEEDINGS","distribution":"PUBLIC","status":"CURATED"},{"disseminated":"DOCUMENT_AND_METADATA","id":20040053504,"type":"ANALYTIC_PRIMARY","title":"Seventh International Workshop on Microgravity Combustion and Chemically Reacting Systems","stiType":"CONFERENCE_PROCEEDINGS","distribution":"PUBLIC","status":"CURATED"}],"downloads":[{"draft":false,"mimetype":"application/pdf","name":"20040053527.pdf","type":"STI","links":{"original":"/api/citations/20040053527/downloads/20040053527.pdf","pdf":"/api/citations/20040053527/downloads/20040053527.pdf","fulltext":"/api/citations/20040053527/downloads/20040053527.txt"}}],"downloadsAvailable":true,"index":"submissions-2026-11-12-06-24"},{"_meta":{"score":144.37392},"copyright":{"thirdPartyPermissionsProduced":false,"disclosedToPublic":false,"containsIndication":false,"publisherPermissionOrRightsToDistribute":false,"belongsToUsGov":false,"determinationType":"GOV_PUBLIC_USE_PERMITTED","thirdPartyContentCondition":"NOT_SET","belongsToContractor":false,"disclosedInvention":false,"submissionId":20010074098,"containsThirdPartyMaterial":false,"belongsToPublisher":false,"id":"6caeff80098f4138b5d46721b82ac8be","belongsToAuthors":false},"subjectCategories":["Inorganic, Organic And Physical Chemistry"],"exportControl":{"isExportControl":"NO","submissionId":20010074098,"ear":"NO","id":"6c90cb418fa64b44bbd757d46334e2b5","itar":"NO"},"distributionDate":"2019-08-15T08:39:34.3870000+00:00","title":"Physical and Chemical Aspects of Fire Suppression in Extraterrestrial Environments","stiType":"CONFERENCE_PAPER","distribution":"PUBLIC","submittedDate":"2013-08-20T11:27:00.0000000+00:00","authorAffiliations":[{"sequence":0,"submissionId":20010074098,"meta":{"author":{"name":"Takahashi, F."},"organization":{"name":"National Center for Microgravity Research on Fluids and Combustion","location":"Cleveland, OH United States"}},"id":"ad1a9bf621cd4c4b8d007db09c87d647"},{"sequence":1,"submissionId":20010074098,"meta":{"author":{"name":"Linteris, G. T."},"organization":{"name":"National Inst. of Standards and Technology","location":"Gaithersburg, MD United States"}},"id":"72379faf96f24bc1a90d4a910c6ba3ba"},{"sequence":2,"submissionId":20010074098,"meta":{"author":{"name":"Katta, V. R."},"organization":{"name":"Innovative Scientific Solutions, Inc.","location":"Dayton, OH United States"}},"id":"6b7e7d70b6354af888fb96797c5e6ae8"}],"stiTypeDetails":"Conference Paper","technicalReviewType":"TECHNICAL_REVIEW_TYPE_NONE","modified":"2025-08-31T18:39:21.7150190+00:00","id":20010074098,"legacyMeta":{"__type":"LegacyMetaIndex, StrivesApi.ServiceModel","accessionNumber":""},"created":"2013-08-20T11:27:00.0000000+00:00","center":{"code":"HQ","name":"Headquarters","id":"f0865a34ba1f474d865ab51f212fc69f"},"onlyAbstract":false,"sensitiveInformation":2,"abstract":"A fire, whether in a spacecraft or in occupied spaces on extraterrestrial bases, can lead to mission termination or loss of life. While the fire-safety record of US space missions has been excellent, the advent of longer duration missions to Mars, the moon, or aboard the International Space Station (ISS) increases the likelihood of fire events, with more limited mission termination options. The fire safety program of NASA's manned space flight program is based largely upon the principles of controlling the flammability of on-board materials and greatly eliminating sources of ignition. As a result, very little research has been conducted on fire suppression in the microgravity or reduced-gravity environment. The objectives of this study are: to obtain fundamental knowledge of physical and chemical processes of fire suppression, using gravity and oxygen concentration as independent variables to simulate various extraterrestrial environments, including spacecraft and surface bases in Mars and moon missions; to provide rigorous testing of analytical models, which include comprehensive descriptions of combustion and suppression chemistry; and to provide basic research results useful for technological advances in fire safety, including the development of new fire-extinguishing agents and approaches, in the microgravity environment associated with ISS and in the partial-gravity Martian and lunar environments.","isLessonsLearned":false,"disseminated":"DOCUMENT_AND_METADATA","publications":[{"submissionId":20010074098,"id":"9fd819e3063c43c7ba9b7cac6c683385","publicationName":"Sixth International Microgravity Combustion Workshop","publicationDate":"2001-05-01T00:00:00.0000000+00:00"}],"status":"CURATED","related":[{"disseminated":"DOCUMENT_AND_METADATA","id":20010073993,"type":"ANALYTIC_PRIMARY","title":"Sixth International Microgravity Combustion Workshop","stiType":"CONFERENCE_PROCEEDINGS","distribution":"PUBLIC","status":"CURATED"},{"disseminated":"DOCUMENT_AND_METADATA","id":20010073993,"type":"ANALYTIC_PRIMARY","title":"Sixth International Microgravity Combustion Workshop","stiType":"CONFERENCE_PROCEEDINGS","distribution":"PUBLIC","status":"CURATED"}],"downloads":[{"draft":false,"mimetype":"application/pdf","name":"20010074098.pdf","type":"STI","links":{"original":"/api/citations/20010074098/downloads/20010074098.pdf","pdf":"/api/citations/20010074098/downloads/20010074098.pdf","fulltext":"/api/citations/20010074098/downloads/20010074098.txt"}}],"downloadsAvailable":true,"index":"submissions-2026-11-12-06-24"},{"_meta":{"score":139.48737},"copyright":{"thirdPartyPermissionsProduced":false,"disclosedToPublic":false,"containsIndication":false,"publisherPermissionOrRightsToDistribute":false,"belongsToUsGov":false,"determinationType":"PUBLIC_USE_PERMITTED","thirdPartyContentCondition":"NOT_SET","belongsToContractor":false,"disclosedInvention":false,"submissionId":20160000593,"containsThirdPartyMaterial":false,"belongsToPublisher":false,"id":"eeb7796e84a3422b8becd98fff9567bf","belongsToAuthors":false},"subjectCategories":["Fluid Mechanics And Thermodynamics","Propellants And Fuels"],"keywords":["Combustion","Fire Safety","Microgravity"],"exportControl":{"isExportControl":"NO","submissionId":20160000593,"ear":"NO","id":"fccb87e7af0443059931841f11962996","itar":"NO"},"distributionDate":"2019-07-11T00:00:00.0000000+00:00","otherReportNumbers":["GRC-E-DAA-TN18274","Report Number: GRC-E-DAA-TN18274"],"fundingNumbers":[{"number":"NNC13BA10B","submissionId":20160000593,"id":"89bf04fb37b54bb285565bff3b132b32","type":"CONTRACT_GRANT"},{"number":"WBS 904211.04.02.30.19","submissionId":20160000593,"id":"416d923af81442eabf927091e6fb0932","type":"WBS"}],"title":"Combustion of Solids in Microgravity: Results from the BASS-II Experiment","stiType":"PRESENTATION","distribution":"PUBLIC","submittedDate":"2016-01-11T15:44:10.7270000+00:00","authorAffiliations":[{"sequence":0,"submissionId":20160000593,"meta":{"author":{"name":"Ferkul, Paul V."},"organization":{"name":"National Center for Space Exploration Research on Fluids and Combustion","location":"Cleveland, OH, United States"}},"id":"2ab85a0aa2504e159f35159e6acc57a2"},{"sequence":1,"submissionId":20160000593,"meta":{"author":{"name":"Bhattacharjee, Subrata "},"organization":{"name":"San Diego State Univ.","location":"San Diego, CA, United States"}},"id":"491eac1d7b434d838b55c6b9090d7bd7"},{"sequence":2,"submissionId":20160000593,"meta":{"author":{"name":"Fernandez-Pello, Carlos"},"organization":{"name":"California Univ.","location":"Berkeley, CA, United States"}},"id":"4be34c796c8a4f2ca1789a1881a38101"},{"sequence":3,"submissionId":20160000593,"meta":{"author":{"name":"Miller, Fletcher "},"organization":{"name":"San Diego State Univ.","location":"San Diego, CA, United States"}},"id":"056cb5861f3a49a7a42502656566b0c4"},{"sequence":4,"submissionId":20160000593,"meta":{"author":{"name":"Olson, Sandra L."},"organization":{"name":"NASA Glenn Research Center","location":"Cleveland, OH United States"}},"id":"040a65361db645e0ad994a31a42b94e5"},{"sequence":5,"submissionId":20160000593,"meta":{"author":{"name":"Takahashi, Fumiaki "},"organization":{"name":"National Center for Space Exploration Research on Fluids and Combustion","location":"Cleveland, OH, United States"}},"id":"d874d712a5ae43099b9ff6396002d1e0"},{"sequence":6,"submissionId":20160000593,"meta":{"author":{"name":"T’ien, James S."},"organization":{"name":"Case Western Reserve Univ.","location":"Cleveland, OH, United States"}},"id":"119111153882412c8ab155bb0b876339"}],"stiTypeDetails":"Presentation","technicalReviewType":"TECHNICAL_REVIEW_TYPE_NONE","modified":"2025-08-31T18:39:21.7150190+00:00","id":20160000593,"legacyMeta":{"__type":"LegacyMetaIndex, StrivesApi.ServiceModel","accessionNumber":""},"created":"2016-01-11T15:44:10.7270000+00:00","center":{"code":"GRC","name":"Glenn Research Center","id":"19eeb25fa404421d9eaa5f876e853e3c"},"onlyAbstract":false,"sensitiveInformation":2,"abstract":"The Burning and Suppression of Solids-II (BASS-II) experiment was performed on the International Space Station. Microgravity combustion tests burned thin and thick flat samples, acrylic slabs, spheres, and cylinders. The samples were mounted inside a small wind tunnel which could impose air flow speeds up to 53 cms. The wind tunnel was installed in the Microgravity Science Glovebox which supplied power, imaging, and a level of containment. The effects of air flow speed, fuel thickness, fuel preheating, and oxygen concentration on flame appearance, growth, spread rate, and extinction were examined in both the opposed and concurrent flow configuration. The flames are quite sensitive to air flow speed in the range 0 to 5 cms. They can be sustained at very low flow speeds of less than 1 cms, when they become dim blue and stable. In this state they are not particularly dangerous from a fire safety perspective, but they can flare up quickly with a sudden increase in air flow speed. Including earlier BASS-I results, well over one hundred tests have been conducted of the various samples in the different geometries, flow speeds, and oxygen concentrations. There are several important implications related to fundamental combustion research as well as spacecraft fire safety. This work was supported by the NASA Space Life and Physical Sciences Research and Applications Division (SLPSRA).","isLessonsLearned":false,"disseminated":"DOCUMENT_AND_METADATA","meetings":[{"submissionId":20160000593,"name":"American Society for Gravitational and Space Research","location":"Bristow, VA, United States","id":"8bc64476676e41f98ebee26e0d1e1d65"},{"country":"United States","submissionId":20160000593,"endDate":"2014-10-26T00:00:00.0000000+00:00","sponsors":[{"meta":{"organization":{"name":"American Society for Gravitational and Space Research","location":"Bristow, VA, United States"}},"meetingId":"67ae4cd67d26468383ce53978524d2fe","id":"bfa04a35ce95415795103da0276bd471"}],"name":"American Society for Gravitational and Space Research Conference","location":"Pasadena, CA","id":"67ae4cd67d26468383ce53978524d2fe","startDate":"2014-10-23T00:00:00.0000000+00:00"}],"publications":[{"submissionId":20160000593,"id":"436859c07a8441408e5429519d7e8fcb","publicationDate":"2014-10-23T00:00:00.0000000+00:00"}],"status":"CURATED","related":[],"downloads":[{"draft":false,"mimetype":"application/pdf","name":"20160000593.pdf","type":"STI","links":{"original":"/api/citations/20160000593/downloads/20160000593.pdf","pdf":"/api/citations/20160000593/downloads/20160000593.pdf","fulltext":"/api/citations/20160000593/downloads/20160000593.txt"}}],"downloadsAvailable":true,"index":"submissions-2026-11-12-06-24"}],"aggregations":{"created":{"buckets":[{"key_as_string":"2013","key":1356998400000,"doc_count":233},{"key_as_string":"2017","key":1483228800000,"doc_count":9},{"key_as_string":"2021","key":1609459200000,"doc_count":8},{"key_as_string":"2014","key":1388534400000,"doc_count":7},{"key_as_string":"2015","key":1420070400000,"doc_count":4},{"key_as_string":"2016","key":1451606400000,"doc_count":3},{"key_as_string":"2020","key":1577836800000,"doc_count":3},{"key_as_string":"2022","key":164099