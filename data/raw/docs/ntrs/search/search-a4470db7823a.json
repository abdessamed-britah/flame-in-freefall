{"stats":{"took":97,"total":1,"estimate":false,"maxScore":402.7975},"results":[{"_meta":{"score":402.7975},"copyright":{"thirdPartyPermissionsProduced":false,"disclosedToPublic":false,"containsIndication":false,"publisherPermissionOrRightsToDistribute":false,"belongsToUsGov":false,"determinationType":"OTHER","thirdPartyContentCondition":"NOT_SET","belongsToContractor":false,"disclosedInvention":false,"submissionId":20070021776,"containsThirdPartyMaterial":false,"belongsToPublisher":false,"id":"54c2cbd3b285445991b50c64b921ad71","belongsToAuthors":false},"subjectCategories":["Fluid Mechanics And Thermodynamics"],"exportControl":{"isExportControl":"NO","submissionId":20070021776,"ear":"NO","id":"22246b3e8a2a4701a499c77e023d560b","itar":"NO"},"distributionDate":"2019-07-12T00:00:00.0000000+00:00","otherReportNumbers":["2007-01-3076","Report Number: 2007-01-3076"],"fundingNumbers":[{"number":"WBS 567524.04.02.02","submissionId":20070021776,"id":"bdea723767574d919fedd944125d8db6","type":"WBS"}],"title":"ISS Destiny Laboratory Smoke Detection Model","stiType":"CONFERENCE_PAPER","distribution":"PUBLIC","submittedDate":"2013-08-23T23:08:00.0000000+00:00","authorAffiliations":[{"sequence":0,"submissionId":20070021776,"meta":{"author":{"name":"Brooker, John E."},"organization":{"name":"NASA Glenn Research Center","location":"Cleveland, OH, United States"}},"id":"03b05e083ead4b60b3f53b123561c36d"},{"sequence":1,"submissionId":20070021776,"meta":{"author":{"name":"Urban, David L."},"organization":{"name":"NASA Glenn Research Center","location":"Cleveland, OH, United States"}},"id":"97823c0358b14765830f27d27a494517"},{"sequence":2,"submissionId":20070021776,"meta":{"author":{"name":"Ruff, Gary A."},"organization":{"name":"NASA Glenn Research Center","location":"Cleveland, OH, United States"}},"id":"198f58e4c6b94c1a94d74adae7039377"}],"stiTypeDetails":"Conference Paper","technicalReviewType":"TECHNICAL_REVIEW_TYPE_NONE","modified":"2025-08-31T18:39:21.7150190+00:00","id":20070021776,"legacyMeta":{"__type":"LegacyMetaIndex, StrivesApi.ServiceModel","accessionNumber":""},"created":"2013-08-23T23:08:00.0000000+00:00","center":{"code":"ARC","name":"Ames Research Center","id":"4540cd94d24c4bf29f8773a27faf96b2"},"onlyAbstract":false,"sensitiveInformation":2,"abstract":"Smoke transport and detection were modeled numerically in the ISS Destiny module using the NIST, Fire Dynamics Simulator code. The airflows in Destiny were modeled using the existing flow conditions and the module geometry included obstructions that simulate the currently installed hardware on orbit. The smoke source was modeled as a 0.152 by 0.152 m region that emitted smoke particulate ranging from 1.46 to 8.47 mg/s. In the module domain, the smoke source was placed in the center of each Destiny rack location and the model was run to determine the time required for the two smoke detectors to alarm. Overall the detection times were dominated by the circumferential flow, the axial flow from the intermodule ventilation and the smoke source strength.","isLessonsLearned":false,"disseminated":"METADATA_ONLY","meetings":[{"country":"United States","submissionId":20070021776,"sponsors":[{"organizationId":"3dd6798b3d91459f92023fb28513e5f9","meta":{"organization":{"name":"Society of Automotive Engineers, Inc.","location":"United States"}},"meetingId":"7ce322c3679846389dbf40b10c11151d","id":"be2e348a156b40599d9df07eb66334b9"}],"name":"37th International Conference on Environmental Systems","location":"Chicago, IL","id":"7ce322c3679846389dbf40b10c11151d","startDate":"2007-07-09T00:00:00.0000000+00:00"}],"publications":[{"submissionId":20070021776,"id":"a90ecaac848a4d75be3ca44e1d4d2819","publicationDate":"2007-07-09T00:00:00.0000000+00:00"}],"status":"CURATED","related":[],"downloads":[],"downloadsAvailable":false,"index":"submissions-2026-11-12-06-24"}],"aggregations":{"created":{"buckets":[{"key_as_string":"2013","key":1356998400000,"doc_count":1}]},"author":{"doc_count_error_upper_bound":0,