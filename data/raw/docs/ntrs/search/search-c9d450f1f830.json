":{"name":"Urban, D. L."},"organization":{"name":"NASA Glenn Research Center","location":"Cleveland, OH United States"}},"id":"b53183453f7a4505bdfc06f1b9ba6d37"},{"sequence":4,"submissionId":20010117668,"meta":{"author":{"name":"Yuan, Z.-G."},"organization":{"name":"NASA Glenn Research Center","location":"Cleveland, OH United States"}},"id":"a56a79c6a2ea4d2888f24417cd46e5b5"},{"sequence":5,"submissionId":20010117668,"meta":{"author":{"name":"Ross, Howard B."},"organization":{}},"id":"599868c5989d4c8487c3ee8472b508c7"}],"stiTypeDetails":"Reprint (Version printed in journal)","technicalReviewType":"TECHNICAL_REVIEW_TYPE_NONE","modified":"2025-08-31T18:39:21.7150190+00:00","id":20010117668,"legacyMeta":{"__type":"LegacyMetaIndex, StrivesApi.ServiceModel","accessionNumber":""},"created":"2013-08-20T10:26:00.0000000+00:00","center":{"code":"GRC","name":"Glenn Research Center","id":"19eeb25fa404421d9eaa5f876e853e3c"},"onlyAbstract":false,"sensitiveInformation":2,"abstract":"The shapes (luminous flame boundaries) of round luminous nonbuoyant soot-containing hydrocarbon/air laminar jet diffusion flames at microgravity were found from color video images obtained on orbit in the Space Shuttle Columbia. Test conditions included ethylene- and propane-fueled flames burning in still air at an ambient temperature of 300 K ambient pressures of 35-130 kPa, initial jet diameters of 1.6 and 2.7 mm, and jet exit Reynolds numbers of 45-170. Present test times were 100-200 s and yielded steady axisymmetric flames that were close to the laminar smoke point (including flames both emitting and not emitting soot) with luminous flame lengths of 15-63 mm. The present soot-containing flames had larger luminous flame lengths than earlier ground-based observations having similar burner configurations: 40% larger than the luminous flame lengths of soot-containing low gravity flames observed using an aircraft (KC-135) facility due to reduced effects of accelerative disturbances and unsteadiness; roughly twice as large as the luminous flame lengths of soot-containing normal gravity flames due to the absence of effects of buoyant mixing and roughly twice as large as the luminous flame lengths of soot-free low gravity flames observed using drop tower facilities due to the presence of soot luminosity and possible reduced effects of unsteadiness, Simplified expressions to estimate the luminous flame boundaries of round nonbuoyant laminar jet diffusion flames were obtained from the classical analysis of Spalding; this approach provided successful correlations of flame shapes for both soot-free and soot-containing flames, except when the soot-containing flames were in the opened-tip configuration that is reached at fuel flow rates near and greater than the laminar smoke point fuel flow rate.","isLessonsLearned":false,"disseminated":"METADATA_ONLY","publications":[{"submissionId":20010117668,"issn":"0010-2180","id":"586e793392944a2695caa57915cdda27","publicationName":"Laminar Soot Processes (LSP)","publicationDate":"2000-12-15T00:00:00.0000000+00:00"}],"status":"CURATED","related":[],"downloads":[],"downloadsAvailable":false,"index":"submissions-2026-11-12-06-24"},{"_meta":{"score":613.5281},"copyright":{"thirdPartyPermissionsProduced":false,"disclosedToPublic":false,"containsIndication":false,"publisherPermissionOrRightsToDistribute":false,"belongsToUsGov":false,"determinationType":"PUBLIC_USE_PERMITTED","thirdPartyContentCondition":"NOT_SET","belongsToContractor":false,"disclosedInvention":false,"submissionId":20000030674,"containsThirdPartyMaterial":false,"belongsToPublisher":false,"id":"024ce2e3b31949ae95aca058088f1c82","belongsToAuthors":false},"subjectCategories":["Inorganic, Organic And Physical Chemistry"],"exportControl":{"isExportControl":"NO","submissionId":20000030674,"ear":"NO","id":"cd8f7e2165a948b5b4dc4e37a9c72260","itar":"NO"},"distributionDate":"2019-07-11T00:00:00.0000000+00:00","otherReportNumbers":["ISSN: 0010-2180"],"fundingNumbers":[{"number":"NAG3-2048","submissionId":20000030674,"id":"aa04a72960ae42db9d6c665ab74bf218","type":"CONTRACT_GRANT"},{"number":"NAG3-1245","submissionId":20000030674,"id":"26ade17b1faa47f9a84e317bc8d50eae","type":"CONTRACT_GRANT"},{"number":"RTOP 101-12-OA","submissionId":20000030674,"id":"f9b5b1f47a504b919960b56a73927088","type":"PROJECT"}],"title":"Shapes of Nonbuoyant Round Luminous Hydrocarbon/Air Laminar Jet Diffusion Flames","stiType":"PREPRINT","distribution":"PUBLIC","submittedDate":"2013-09-07T12:45:00.0000000+00:00","authorAffiliations":[{"sequence":0,"submissionId":20000030674,"meta":{"author":{"name":"Lin, K.-C."},"organization":{"name":"Michigan Univ.","location":"Ann Arbor, MI United States"}},"id":"adfd023dc0a14569a6d20b6c34dde35e"},{"sequence":1,"submissionId":20000030674,"meta":{"author":{"name":"Faeth, G. M."},"organization":{"name":"Michigan Univ.","location":"Ann Arbor, MI United States"}},"id":"c79eb5ef2cc540f6a91873709925d25a"},{"sequence":2,"submissionId":20000030674,"meta":{"author":{"name":"Sunderland, P. B."},"organization":{"name":"NASA Lewis Research Center","location":"Cleveland, OH United States"}},"id":"7f2a336dd3df4f92a4ce3c28f83f9da5"},{"sequence":3,"submissionId":20000030674,"meta":{"author":{"name":"Urban, D. L."},"organization":{"name":"NASA Lewis Research Center","location":"Cleveland, OH United States"}},"id":"ec50052fa9034c599d09a0a7ca25e935"},{"sequence":4,"submissionId":20000030674,"meta":{"author":{"name":"Yuan, Z.-G."},"organization":{"name":"NASA Lewis Research Center","location":"Cleveland, OH United States"}},"id":"4acb83ce487d4812b89bf5e286855a06"}],"stiTypeDetails":"Preprint (Draft being sent to journal)","technicalReviewType":"TECHNICAL_REVIEW_TYPE_NONE","modified":"2025-08-31T18:39:21.7150190+00:00","id":20000030674,"sourceIdentifiers":[{"number":"doi:10.1016/S0010-2180(98)00100-X","submissionId":20000030674,"id":"1acaa802d5e14aafb9ba168d381170fd","type":"DOI"},{"submissionId":20000030674,"id":"317bc8f7ee284dcd84c4d5856ae0a5a7","descriptor":"doi:10.1016/S0010-2180(98)00100-X"}],"legacyMeta":{"__type":"LegacyMetaIndex, StrivesApi.ServiceModel","accessionNumber":""},"created":"2013-09-07T12:45:00.0000000+00:00","center":{"code":"CDMS","name":"Legacy CDMS","id":"092d6e0881874968859b972d39a888dc"},"onlyAbstract":false,"sensitiveInformation":2,"abstract":"The shapes (luminous flame boundaries) of round luminous nonbuoyant soot-containing hydrocarbon/air laminar jet diffusion flames at microgravity were found from color video images obtained on orbit in the Space Shuttle Columbia. Test conditions included ethylene- and propane-fueled flames burning in still air at an ambient temperature of 300 K, ambient pressures of 35-130 kPa, initial jet diameters of 1.6 and 2.7 mm, and jet exit Reynolds numbers of 45-170. Present test times were 100-200 s and yielded steady axisymmetric flames that were close to the laminar smoke point (including flames both emitting and not emitting soot) with luminous flame lengths of 15-63 mm. The present soot-containing flames had larger luminous flame lengths than earlier ground-based observations having similar burner configurations: 40% larger than the luminous flame lengths of soot-containing low gravity flames observed using an aircraft (KC-135) facility due to reduced effects of accelerative disturbances and unsteadiness; roughly twice as large as the luminous flame lengths of soot-containing normal gravity flames due to the absence of effects of buoyant mixing and roughly twice as large as the luminous flame lengths of soot-free low gravity flames observed using drop tower facilities due to the presence of soot luminosity and possible reduced effects of unsteadiness. Simplified expressions to estimate the luminous flame boundaries of round nonbuoyant laminar jet diffusion flames were obtained from the classical analysis of Spalding (1979); this approach provided Successful Correlations of flame shapes for both soot-free and soot-containing flames, except when the soot-containing flames were in the opened-tip configuration that is reached at fuel flow rates near and greater than the laminar smoke point fuel flow rate.","isLessonsLearned":false,"disseminated":"DOCUMENT_AND_METADATA","publications":[{"volume":"116","submissionId":20000030674,"issn":"0010-2180","publisher":"Elsevier Science Inc.","id":"801ca82eb1ee41259cea0050a421a19d","publicationName":"Combustion and Flame","publicationDate":"1999-01-01T00:00:00.0000000+00:00"}],"status":"CURATED","related":[],"downloads":[{"draft":false,"mimetype":"application/pdf","name":"20000030674.pdf","type":"STI","links":{"original":"/api/citations/20000030674/downloads/20000030674.pdf","pdf":"/api/citations/20000030674/downloads/20000030674.pdf","fulltext":"/api/citations/20000030674/downloads/20000030674.txt"}}],"downloadsAvailable":true,"index":"submissions-2026-11-12-06-24"},{"_meta":{"score":587.54144},"copyright":{"thirdPartyPermissionsProduced":false,"disclosedToPublic":false,"containsIndication":false,"publisherPermissionOrRightsToDistribute":false,"belongsToUsGov":false,"determinationType":"PUBLIC_USE_PERMITTED","thirdPartyContentCondition":"NOT_SET","belongsToContractor":false,"disclosedInvention":false,"submissionId":20010117316,"containsThirdPartyMaterial":false,"belongsToPublisher":false,"id":"ba9c239754164c91a374bd57aa3ac929","belongsToAuthors":false},"subjectCategories":["Inorganic, Organic And Physical Chemistry"],"exportControl":{"isExportControl":"NO","submissionId":20010117316,"ear":"NO","id":"cab24206cd044a1bbabb7353ced6736c","itar":"NO"},"distributionDate":"2019-07-09T00:00:00.0000000+00:00","fundingNumbers":[{"number":"NAG3-2048","submissionId":20010117316,"id":"0dc3f72e492949049904977724a81cb3","type":"CONTRACT_GRANT"},{"number":"NAG3-1245","submissionId":20010117316,"id":"04992228421544a8ba28ab1cf7e70de4","type":"CONTRACT_GRANT"},{"number":"N00014-95-0238","submissionId":20010117316,"id":"7d5a29bcf9ec4b6d8adc4a4d895cbecd","type":"CONTRACT_GRANT"}],"title":"Shapes of Nonbuoyant Round Luminous Laminar-Jet Diffusion Flames in Coflowing Air","stiType":"REPRINT","distribution":"PUBLIC","submittedDate":"2013-09-07T12:36:00.0000000+00:00","authorAffiliations":[{"sequence":0,"submissionId":20010117316,"meta":{"author":{"name":"Lin, K.-C."},"organization":{"name":"Michigan Univ.","location":"Ann Arbor, MI United States"}},"id":"3310721eb08a460585ac8cf46ff136b0"},{"sequence":1,"submissionId":20010117316,"meta":{"author":{"name":"Faeth, G. M."},"organization":{"name":"Michigan Univ.","location":"Ann Arbor, MI United States"}},"id":"10249e7ca7a04a11b9b309a0f626e5a1"},{"sequence":2,"submissionId":20010117316,"meta":{"author":{"name":"Urban, David L."},"organization":{}},"id":"6dfbb3713a1947c9af2fe81ebf050c7e"}],"stiTypeDetails":"Reprint (Version printed in journal)","technicalReviewType":"TECHNICAL_REVIEW_TYPE_NONE","modified":"2025-08-31T18:39:21.7150190+00:00","id":20010117316,"legacyMeta":{"__type":"LegacyMetaIndex, StrivesApi.ServiceModel","accessionNumber":""},"created":"2013-09-07T12:36:00.0000000+00:00","center":{"code":"GRC","name":"Glenn Research Center","id":"19eeb25fa404421d9eaa5f876e853e3c"},"onlyAbstract":false,"sensitiveInformation":2,"abstract":"The shapes (luminous flame boundaries) of steady nonbuoyant round luminous hydrocarbon-fueled laminar-jet diffusion flames in coflowing air were studied both experimentally and theoretically. Flame shapes were measured from photographs of flames burning at low pressures in order to minimize the effects of buoyancy. Test conditions involved acetylene-, propylene. and 1,3-butadiene-fueled flames having initial reactant temperatures of 300 K, ambient pressures of 19-50 kPa, jet-exit Reynolds numbers of 18-121, and initial air/fuel velocity ratios of 0.22-32.45 to yield luminous flame lengths of 21-198 mm. The present flames were close to the laminar smoke point but were not soot emitting. Simple expressions to estimate the shapes of nonbuoyant laminar-jet diffusion flames in coflow were found by extending an earlier analysis of Mahalingam et al. These formulas provided a good correlation of present measurements except near the burner exit where self-similar approximations used in the simplified analysis are no longer appropriate.","isLessonsLearned":false,"disseminated":"DOCUMENT_AND_METADATA","publications":[{"submissionId":20010117316,"id":"c35bb0bb7f254d64b52a1801b43d5a28","publicationName":"Laminar Soot Processes (LSP)","publicationDate":"2000-12-15T00:00:00.0000000+00:00"}],"status":"CURATED","related":[],"downloads":[{"draft":false,"mimetype":"application/pdf","name":"20010117316.pdf","type":"STI","links":{"original":"/api/citations/20010117316/downloads/20010117316.pdf","pdf":"/api/citations/20010117316/downloads/20010117316.pdf","fulltext":"/api/citations/20010117316/downloads/20010117316.txt"}}],"downloadsAvailable":true,"index":"submissions-2026-11-12-06-24"}],"aggregations":{"created":{"buckets":[{"key_as_string":"2013","key":1356998400000,"doc_count":6}]},"author":{"doc_count_error_upper_bound":0,"sum_other_doc_count":0,"buckets":[{"key":"Faeth, G. M.","doc_count":6},{"key":"Urban, D. L.","doc_count":5},{"key":"Yuan, Z.-G.","doc_count":4},{"key":"Lin, K.-C.","doc_count":3},{"key":"Xu, F.","doc_count":3},{"key":"Dai, Z.","doc_count":2},{"key":"Sunderland, P. B.","doc_count":2},{"key":"Ross, Howard B.","doc_count":1},{"key":"Urban, David L.","doc_count":1},{"key":"Yuan, Z. G.","doc_count":1}]},"reportNumber":{"doc_count_error_upper_bound":0,"sum_other_doc_count":0,"buckets":[{"key":"ISSN: 0010-2180","doc_count":2},{"key":"ISSN: 0001-1452","doc_count":1}]},"center":{"doc_count_error_upper_bound":0,"sum_other_doc_count":0,"buckets":[{"key":"GRC","doc_count":5},{"key":"CDMS","doc_count":1}]},"index":{"doc_count_error_upper_bound":0,"sum_other_doc_count":0,"buckets":[{"key":"submissions-2026-11-12-06-24","doc_count":6}]},"fundingNumber":{"doc_count_error_upper_bound":0,"sum_other_doc_count":0,"buckets":[{"key":"NAG3-2048","doc_count":6},{"ke